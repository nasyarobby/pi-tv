# Pi TV server configuration. Copy to /etc/pi-tv/pi-tv.env (chmod 600).
# Environment variables with the same names override this file.

# HTTP port (the remotes connect to http://<pi-address>:PORT). LAN only:
# do NOT port-forward this on your router.
PORT=8787

# 6-digit numeric PIN (000000-999999, leading zeros allowed).
# Leave unset to have one generated on first start; it is printed to the
# journal and saved to ~/.pi-tv/pin.
#TV_PIN=

# Colon-separated media folders (scanned recursively).
MEDIA_DIRS=/home/pi/Videos:/media/pi

# HDMI-CEC: wake the TV and switch input when playback starts (on|off).
CEC=on

# Leave empty to find them on PATH.
#CHROMIUM_PATH=/usr/bin/chromium
#MPV_PATH=/usr/bin/mpv
#MPV_EXTRA_ARGS=--audio-device=alsa/hdmi:CARD=vc4hdmi0,DEV=0

# Flutter web remote served at /
WEB_DIR=/opt/pi-tv/web

# Optional
#BIND=0.0.0.0
#DATA_DIR=/home/pi/.pi-tv
#CDP_PORT=9333
#INHIBIT=on
#DISPLAY_MODE=auto        # auto | wayland | x11
#PUBLIC_URL=http://192.168.1.20:8787
